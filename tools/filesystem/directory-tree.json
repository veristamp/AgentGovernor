{
  "qualifiedName": "filesystem.directory-tree",
  "serverPrefix": "filesystem",
  "name": "directory-tree",
  "originalName": "directory_tree",
  "description": "Recursive directory tree as JSON. Supports excludePatterns globs, max_depth, max_nodes. Only works within allowed directories.",
  "schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string"
      },
      "excludePatterns": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": []
      },
      "max_depth": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "default": 5
      },
      "max_nodes": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "default": 5000
      }
    },
    "required": [
      "path"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  }
}