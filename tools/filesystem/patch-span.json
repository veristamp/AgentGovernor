{
	"qualifiedName": "filesystem.patch-span",
	"serverPrefix": "filesystem",
	"name": "patch-span",
	"originalName": "patch_span",
	"description": "Replace a 0-based character span [start:end] with new content. Optional sha256 guard on selected slice. Use dry_run=true first.",
	"schema": {
		"type": "object",
		"properties": {
			"path": {
				"type": "string"
			},
			"start": {
				"type": "integer",
				"minimum": 0
			},
			"end": {
				"type": "integer",
				"minimum": 0
			},
			"new_content": {
				"type": "string"
			},
			"expected_sha256": {
				"type": "string"
			},
			"allow_drift": {
				"type": "boolean",
				"default": false
			},
			"dry_run": {
				"type": "boolean",
				"default": true
			}
		},
		"required": ["path", "start", "end", "new_content"],
		"additionalProperties": false,
		"$schema": "http://json-schema.org/draft-07/schema#"
	}
}
