{
  "qualifiedName": "filesystem.grep-search",
  "serverPrefix": "filesystem",
  "name": "grep-search",
  "originalName": "grep_search",
  "description": "Search files for a regex pattern. Returns matching lines and file paths. Only works within allowed directories.",
  "schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string"
      },
      "pattern": {
        "type": "string"
      },
      "excludePatterns": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": []
      },
      "limit": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "default": 5000
      }
    },
    "required": [
      "path",
      "pattern"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  }
}