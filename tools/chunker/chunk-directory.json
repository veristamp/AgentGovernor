{
	"qualifiedName": "chunker.chunk-directory",
	"serverPrefix": "chunker",
	"name": "chunk-directory",
	"originalName": "chunk_directory",
	"description": "Chunk all supported files in a directory.",
	"schema": {
		"type": "object",
		"properties": {
			"directory": {
				"title": "Directory",
				"type": "string"
			},
			"recursive": {
				"default": false,
				"title": "Recursive",
				"type": "boolean"
			},
			"extensions": {
				"anyOf": [
					{
						"items": {
							"type": "string"
						},
						"type": "array"
					},
					{
						"type": "null"
					}
				],
				"default": null,
				"title": "Extensions"
			},
			"output_suffix": {
				"default": "_structured.json",
				"title": "Output Suffix",
				"type": "string"
			},
			"overlap_tokens": {
				"default": 300,
				"title": "Overlap Tokens",
				"type": "integer"
			},
			"max_tokens_text": {
				"default": 2000,
				"title": "Max Tokens Text",
				"type": "integer"
			},
			"split_code_max_lines": {
				"default": 50,
				"title": "Split Code Max Lines",
				"type": "integer"
			},
			"split_table_rows": {
				"default": 100,
				"title": "Split Table Rows",
				"type": "integer"
			},
			"use_treesitter": {
				"default": true,
				"title": "Use Treesitter",
				"type": "boolean"
			},
			"emit_heading_chunks": {
				"default": true,
				"title": "Emit Heading Chunks",
				"type": "boolean"
			},
			"inject_headers": {
				"default": true,
				"title": "Inject Headers",
				"type": "boolean"
			},
			"include_results": {
				"default": false,
				"title": "Include Results",
				"type": "boolean"
			}
		},
		"required": ["directory"],
		"title": "chunk_directoryArguments"
	}
}
