{
    "mcpServers": {
      "context7": {
        "command": "npx",
        "args": ["-y", "@upstash/context7-mcp@latest"]
      },
      "mcp-ui Docs": {
        "serverUrl": "https://gitmcp.io/idosal/mcp-ui"
      },
      "chrome-devtools": {
        "command": "npx",
        "args": ["-y", "chrome-devtools-mcp@latest",
                "--browser-url=http://127.0.0.1:8000"
        ]
      },
      "modelcontextprotocol python sdk": {
        "command": "npx",
        "args": [
          "-y",
          "mcp-code-graph@latest",
          "modelcontextprotocol/python-sdk"
        ]
      }
    }
  }
