{
  "name": "mcp-inspector",
  "version": "2.0.0",
  "description": "Governed Code Mode - Secure AI Agent Execution Framework",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "analyze": "uv run auditor/analyzer.py",
    "execute": "bun run src/index.ts --execute"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.0.6"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "zod": "^4.3.5"
  }
}